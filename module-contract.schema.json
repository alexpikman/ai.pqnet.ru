{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqlocalagentos.example/schemas/module-contract.schema.json",
  "title": "PQlocalAgentOSv3 Module Manifest",
  "type": "object",
  "required": ["id", "name", "version", "description", "api_version"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
    "description": {"type": "string", "maxLength": 1000},
    "author": {"type": "string", "maxLength": 160},
    "license": {"type": "string", "maxLength": 80},
    "repository": {"type": "string", "format": "uri"},
    "api_version": {"type": "string"},
    "entrypoint": {"type": "string"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "pages": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["input", "template", "ollama", "transform", "output"]},
        "template": {"type": "string", "maxLength": 12000},
        "system_prompt": {"type": "string", "maxLength": 4000},
        "model": {"type": "string", "maxLength": 160},
        "max_tokens": {"type": "integer", "minimum": 64, "maximum": 4096},
        "operation": {"enum": ["uppercase", "lowercase", "strip", "json_parse", "json_pretty"]}
      },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "required": {"type": "boolean", "default": false},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
